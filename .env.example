# --- AI vision (analysis of the garden photos) -- optional. Leave all empty = Demo Mode.
# Photos are sent to the provider ONLY when a key is set. Anthropic is used first if both are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=            # also enables the vision fallback (gpt-4o) AND image generation below
OPENAI_VISION_MODEL=gpt-4o
# --- Image generation ("after" visualisation) -- optional
REPLICATE_API_TOKEN=             # alternative to OPENAI_API_KEY for images (text-to-image, ignores the photo)
